# /etc/systemd/system/vitalis.service
# O vigia do processo: sobe o site quando a VPS liga e reinicia se ele cair.
[Unit]
Description=Vitalis - conferencia de guias (Streamlit)
After=network.target

[Service]
User=vitalis
Group=vitalis
WorkingDirectory=/opt/vitalis
# Segredos e configuracao ficam aqui, fora do repositorio (root:vitalis 640).
EnvironmentFile=/etc/vitalis/env
Environment=VITALIS_DB=/var/lib/vitalis/historico.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/vitalis/.venv/bin/streamlit run app/app.py --server.port 8502 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
